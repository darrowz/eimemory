# Copy to /etc/eimemory/governance.env with mode 0600.
# This default adapter reuses the operator's OpenClaw provider/model/fallback configuration.
EIMEMORY_PROMPT_SAFETY_COMMAND='["/opt/eimemory/current/.venv/bin/python","-m","eimemory.governance.prompt_safety_openclaw"]'
EIMEMORY_OPENCLAW_BIN=/home/USER/.local/bin/openclaw
# Leave blank to use OpenClaw's configured default model and fallback chain.
EIMEMORY_PROMPT_SAFETY_MODEL=
EIMEMORY_PROMPT_SAFETY_TIMEOUT_SECONDS=180
EIMEMORY_PROMPT_SAFETY_MAX_ATTEMPTS=2
EIMEMORY_PROMPT_SAFETY_PROMPT_FILES='["/home/USER/.openclaw/workspace/AGENTS.md","/home/USER/.openclaw/workspace/SOUL.md"]'
# Optional enhancement path: source selection uses this model, then deterministically falls back on any LLM error.
# EIMEMORY_LLM_COMMAND='["/opt/eimemory/current/.venv/bin/python","-m","eimemory.llm.openclaw_adapter"]'
EIMEMORY_LLM_MODEL=
EIMEMORY_LLM_TIMEOUT_SECONDS=90
# With neither shared nor research-specific command set, research review discovers
# the service user's Hermes installation and reads its current provider/model.
# Normal installations need no additional settings. A selected explicit command
# remains authoritative; failure never falls back or approves a review.
# Managed deployment validates the selected route before switching current.
# For a nonstandard installation/profile, optional durable overrides are:
# EIMEMORY_HERMES_BIN=/absolute/installed/hermes
# EIMEMORY_HERMES_AGENT_ROOT=/absolute/installed/hermes-agent
# EIMEMORY_HERMES_HOME=/absolute/profile-home
# EIMEMORY_RESEARCH_REVIEW_LLM_COMMAND='["/absolute/python","/absolute/review_bridge.py"]'
# EIMEMORY_RESEARCH_REVIEW_LLM_TIMEOUT_SECONDS=90
# EIMEMORY_ALLOWED_REVIEW_MODELS=provider/model
# Strict v2 policy is deployment-controlled and must be a regular 0600 file.
# Bootstrap defaults are fail-closed: all effects remain disabled and the
# kill-switch path blocks new forward transactions when present.
EIMEMORY_CODE_AUTOMATION_POLICY_PATH=/etc/eimemory/code-automation-policy.v2.json
EIMEMORY_CODE_EVOLUTION_KILL_SWITCH=/etc/eimemory/code-evolution.disabled
EIMEMORY_CODE_AUTOMATION_POLICY_JSON='{"schema_version":"code_automation_policy.v1","policy_id":"diagnostic-all-effects-disabled-v1","actions":{"local_apply":false,"commit":false,"deployment":false}}'
# Alternative: point EIMEMORY_PROMPT_SAFETY_COMMAND at prompt_safety_remote and configure
# EIMEMORY_PROMPT_SAFETY_BASE_URL, EIMEMORY_PROMPT_SAFETY_API_KEY, and EIMEMORY_PROMPT_SAFETY_MODEL.
