#!/usr/bin/env bash
set -Eeuo pipefail

REPO="${REPO_DIR:-${EIMEMORY_TRUSTED_REPOSITORY_ROOT:-$(pwd)}}"
INSTALLER="$REPO/deploy/install_immutable_release.sh"
COLLECTOR="$REPO/deploy/collect_release_health.py"
STATE_DIR=/var/lib/eimemory/state/deploy-jobs
LOCK_FILE=/var/lib/eimemory/state/eimemory-deploy-worker.lock
MODE="${1:-}"
COMMIT="${2:-}"

if [[ "$MODE" != "check" && "$MODE" != "deploy" ]]; then
  echo "usage: $0 {check|deploy} <40-hex-commit>" >&2
  exit 64
fi
if [[ ! "$COMMIT" =~ ^[0-9a-f]{40}$ ]]; then
  echo "invalid commit" >&2
  exit 64
fi

mkdir -p "$STATE_DIR"
exec 9>"$LOCK_FILE"
flock -n 9 || { echo "another deployment is active" >&2; exit 75; }

cd "$REPO"
git fetch origin --prune
test "$(git rev-parse --verify "${COMMIT}^{commit}")" = "$COMMIT"
test "$(git rev-parse origin/master)" = "$COMMIT" || { echo "target $COMMIT is not origin/master; push it first" >&2; exit 65; }
worktree_status="$(git status --porcelain=v1)" || exit "$?"
test -z "$worktree_status"
# The installer runs the deploy controls of this checkout and requires them to
# match the target. The target was just verified to be origin/master of the
# trusted remote, so a clean checkout behind it is fast-forwarded (never
# merged, reset or rebased). Anything else fails with the exact fix.
head="$(git rev-parse HEAD)"
if [[ "$head" != "$COMMIT" ]]; then
  if ! git merge-base --is-ancestor "$head" "$COMMIT"; then
    echo "checkout HEAD $head is not an ancestor of $COMMIT; refusing to move it" >&2
    exit 65
  fi
  if [[ "$MODE" == "check" ]]; then
    printf '{"ok":true,"mode":"check","commit":"%s","checkout_fast_forward_required":true,"checkout_head":"%s"}\n' "$COMMIT" "$head"
    exit 0
  fi
  if ! git merge --ff-only --quiet "$COMMIT"; then
    echo "fast-forward failed; run: git -C $REPO merge --ff-only $COMMIT" >&2
    exit 65
  fi
  echo "checkout_fast_forward=$head..$COMMIT" >&2
fi
test "$(git rev-parse HEAD)" = "$COMMIT"
test -x "$INSTALLER"
test -f "$COLLECTOR"

if [[ "$MODE" == "check" ]]; then
  printf '{"ok":true,"mode":"check","commit":"%s"}\n' "$COMMIT"
  exit 0
fi

started="$(date --iso-8601=seconds)"
# Every attempt keeps its own receipt and log. The per-commit receipt/log are
# published from an attempt, but a failed re-run of the same commit never
# replaces a successful receipt (or its log): the live release stays proven.
attempt_id="$(date -u +%Y%m%dT%H%M%SZ)-$$"
receipt="$STATE_DIR/$COMMIT.json"
attempt_receipt="$STATE_DIR/$COMMIT.attempt-$attempt_id.json"
tmp="$attempt_receipt.tmp.$$"
log="$STATE_DIR/$COMMIT.attempt-$attempt_id.log"
canonical_log="$STATE_DIR/$COMMIT.log"
set +e
"$INSTALLER" "$COMMIT" >"$log" 2>&1
installer_rc=$?
binding_rc=0
if [[ "$installer_rc" -eq 0 ]]; then
  /opt/eimemory/current/.venv/bin/python -B "$REPO/deploy/refresh_release_scope_bindings.py" "$COMMIT" "$log" >>"$log" 2>&1
  binding_rc=$?
fi
set -e

current="$(basename "$(readlink -f /opt/eimemory/current 2>/dev/null || true)")"
service="$(systemctl --user is-active eimemory-rpc.service 2>/dev/null || true)"
# urllib collector: exits only 0/1/2. Never use curl redirect (exit 23 write/pipe).
# Isolated interpreter still needs the repo on PYTHONPATH to import eimemory.
set +e
health_json="$(PYTHONPATH="$REPO" /usr/bin/python3 -B "$COLLECTOR" --url http://127.0.0.1:8091/health --probe-only)"
health_rc=$?
# Post-deploy hygiene: remove any source-tree bytecode written into the live
# immutable release after the installer's own checks (e.g. by a gateway
# importing the release). This is the documented operator step, now owned by
# the worker; its exit code is part of the receipt verdict.
bytecode_rc=0
if [[ "$installer_rc" -eq 0 && "$current" == "$COMMIT" ]]; then
  live_release="$(readlink -f /opt/eimemory/current)"
  /usr/bin/python3 -B "$REPO/deploy/clean_release_bytecode.py" \
    --release-dir "$live_release" --releases-root "$(dirname "$live_release")" >>"$log" 2>&1
  bytecode_rc=$?
fi
# Record the trusted deployment checkout in settings.json so operator CLIs
# (live-acceptance, l5-readiness, deployment-receipt) resolve the same trust
# anchor as the managed units without ad-hoc env. Backed up before change;
# unchanged files are not rewritten. Failure is logged, not fatal.
settings_rc=0
if [[ "$installer_rc" -eq 0 ]]; then
  python3 - "${EIMEMORY_CONFIG_DIR:-/etc/eimemory}/settings.json" "$REPO" >>"$log" 2>&1 <<'PY'
import json, os, shutil, sys, time
path, repo = sys.argv[1], os.path.realpath(sys.argv[2])
if not os.path.isfile(path):
    print("trusted_repository_root_setting=skipped settings_missing")
    raise SystemExit(0)
with open(path, encoding="utf-8") as fh:
    data = json.load(fh)
if not isinstance(data, dict):
    raise SystemExit("settings.json is not an object")
if data.get("trusted_repository_root") == repo:
    print("trusted_repository_root_setting=unchanged")
    raise SystemExit(0)
backup = f"{path}.bak-trusted-root-{time.strftime('%Y%m%d%H%M%S')}"
shutil.copy2(path, backup)
data["trusted_repository_root"] = repo
tmp = f"{path}.tmp.{os.getpid()}"
with open(tmp, "w", encoding="utf-8") as fh:
    json.dump(data, fh, indent=2, sort_keys=True)
    fh.write("\n")
    fh.flush()
    os.fsync(fh.fileno())
shutil.copymode(path, tmp)
os.replace(tmp, path)
print(f"trusted_repository_root_setting=updated backup={backup}")
PY
  settings_rc=$?
fi
set -e

python3 - "$tmp" "$COMMIT" "$started" "$installer_rc" "$current" "$service" "$health_rc" "$health_json" "$log" "$binding_rc" "$attempt_id" "$bytecode_rc" <<'PY'
import json, os, sys
from datetime import datetime, timezone
out, commit, started, installer_rc, current, service, health_rc, health_json, log, binding_rc, attempt_id, bytecode_rc = sys.argv[1:]
try:
    health = json.loads(health_json)
    if not isinstance(health, dict):
        health = None
except Exception:
    health = None
health_ok = (
    int(health_rc) == 0
    and isinstance(health, dict)
    and health.get("ok") is True
    and str(health.get("commit") or "") == commit
)
ok = int(bytecode_rc) == 0 and int(binding_rc) == 0 and int(installer_rc) == 0 and current == commit and service == "active" and health_ok
payload = {
    "ok": ok,
    "commit": commit,
    "attempt_id": attempt_id,
    "started_at": started,
    "finished_at": datetime.now(timezone.utc).astimezone().isoformat(),
    "installer_exit_code": int(installer_rc),
    "binding_refresh_exit_code": int(binding_rc),
    "bytecode_cleanup_exit_code": int(bytecode_rc),
    "current_commit": current,
    "rpc_service": service,
    "health_exit_code": int(health_rc),
    "health": health,
    "log": log,
}
with open(out, "w", encoding="utf-8") as fh:
    json.dump(payload, fh, ensure_ascii=False, indent=2)
    fh.write("\n")
    fh.flush()
    os.fsync(fh.fileno())
PY
mv -f "$tmp" "$attempt_receipt"
publish="$(python3 - "$attempt_receipt" "$receipt" "$log" "$canonical_log" <<'PY'
import json, os, shutil, sys
attempt, canonical, attempt_log, canonical_log = sys.argv[1:]

def ok(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh).get("ok") is True
    except (OSError, ValueError, AttributeError):
        return False

def replace(src, dst):
    tmp = f"{dst}.tmp.{os.getpid()}"
    shutil.copyfile(src, tmp)
    with open(tmp, "rb") as fh:
        os.fsync(fh.fileno())
    os.replace(tmp, dst)

if ok(attempt) or not ok(canonical):
    replace(attempt_log, canonical_log)
    replace(attempt, canonical)
    print("published")
else:
    print("kept_successful_receipt")
fd = os.open(os.path.dirname(canonical) or ".", os.O_RDONLY | os.O_DIRECTORY)
try:
    os.fsync(fd)
finally:
    os.close(fd)
PY
)"
printf '{"attempt_receipt":"%s","receipt":"%s","publish":"%s"}\n' "$attempt_receipt" "$receipt" "$publish"

if [[ "$installer_rc" -ne 0 || "$current" != "$COMMIT" || "$service" != "active" || "$health_rc" -ne 0 ]]; then
  exit 1
fi
python3 - "$attempt_receipt" <<'PY'
import json, sys
raise SystemExit(0 if json.load(open(sys.argv[1], encoding="utf-8")).get("ok") is True else 1)
PY
