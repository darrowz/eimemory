[Unit]
Description=eimemory real-effect data trial controller
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
NoNewPrivileges=true
PrivateTmp=true
CPUWeight=20
IOWeight=20
Nice=10
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPYCACHEPREFIX=/var/lib/eimemory/.pycache/runtime
TimeoutStartSec=900
WorkingDirectory=/opt/eimemory/current
Environment=EIMEMORY_ROOT=/var/lib/eimemory
Environment=EIMEMORY_CONFIG_DIR=/etc/eimemory
ExecStart=/opt/eimemory/current/.venv/bin/eimemory effect-tick
