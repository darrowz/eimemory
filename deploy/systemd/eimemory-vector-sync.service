[Unit]
Description=eimemory bounded PostgreSQL vector index maintenance
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/eimemory/current
Environment=EIMEMORY_ROOT=/var/lib/eimemory
Environment=PYTHONPATH=/opt/eimemory/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPYCACHEPREFIX=/var/lib/eimemory/.pycache/runtime
EnvironmentFile=/etc/eimemory/postgres.env
EnvironmentFile=/etc/eimemory/embedding.env
ExecStart=/opt/eimemory/current/.venv/bin/python -m eimemory.retrieval.vector_sync_worker
CPUQuota=50%
MemoryMax=1G
TimeoutStartSec=15min
UMask=0077
