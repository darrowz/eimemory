[Unit]
Description=Drain eimemory L1 extract queue
After=network-online.target eimemory-rpc.service
Wants=network-online.target

[Service]
Type=oneshot
Nice=10
WorkingDirectory=/opt/eimemory/current
Environment=HOME=/home/darrow
Environment=EIMEMORY_ROOT=/var/lib/eimemory
Environment=EIMEMORY_CONFIG_DIR=/etc/eimemory
Environment=EIMEMORY_L1_WORKER_ACTION=drain
Environment=EIMEMORY_L1_DRAIN_LIMIT=5
Environment=PYTHONDONTWRITEBYTECODE=1
StandardOutput=journal
StandardError=journal
ExecStart=/opt/eimemory/current/.venv/bin/python -m eimemory.cli.l1_worker
