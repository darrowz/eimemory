# Private /etc/eimemory/recall.env, consumed by RPC, gateway and index worker.
# This is NOT an activation command. Keep reads/admission off until the matching
# index proof and quality reports have passed; never reuse another generation.
EIMEMORY_POSTGRES_VECTOR_ENABLED=0
EIMEMORY_POSTGRES_MAINTENANCE_ENABLED=1
EIMEMORY_POSTGRES_EVIDENCE_FRAGMENTS=1
EIMEMORY_POSTGRES_PROJECTION_MEMORY_ONLY=1
EIMEMORY_LIGHTWEIGHT_ADMISSION_ENABLED=0
EIMEMORY_CALLER_ASSISTED_RECALL_ENABLED=0
EIMEMORY_RERANKER_ENABLED=0
EIMEMORY_CAPTURE_ORIGINAL_QUERY=1
# Client transport margin is not a larger recall budget: engine stays 3s/10s.
EIMEMORY_ADAPTER_TIMEOUT_SECONDS=11.5
EIMEMORY_RPC_HOOK_TIMEOUT_MS=11500
EIMEMORY_HOOK_TIMEOUT_MS=12000
# Pin actual installed module/export/model, not a guessed path, before enabling.
EIMEMORY_RECALL_GATEWAY_PREWARM=1
# EIMEMORY_RECALL_LLM_COMMAND='["/verified/node","/opt/eimemory/current/eimemory/llm/openclaw_gateway.mjs"]'
# EIMEMORY_OPENCLAW_GATEWAY_MODULE=/verified/openclaw/dist/client-HASH.js
# EIMEMORY_OPENCLAW_GATEWAY_EXPORT=t
# EIMEMORY_OPENCLAW_GATEWAY_MODE=client
# EIMEMORY_OPENCLAW_GATEWAY_CONFIG=/verified/private/openclaw.json
# EIMEMORY_RECALL_MODEL_THINKING=low
# EIMEMORY_RECALL_EXPECTED_MODEL=xai/grok-4.6
# Set table and calibrated thresholds from the accepted, immutable report.
# Original-query capture must use the documented private vault opt-in/retention.
