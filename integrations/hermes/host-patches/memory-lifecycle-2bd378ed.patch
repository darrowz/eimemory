+"""Exclusive transfer of a cached agent's memory owner during a gateway rebuild.
+
+The cache supplies the actual previous agent; kwargs never locate another
+manager. The token is consumed by agent initialization, not a provider proxy.
+"""
+from __future__ import annotations
+
+from contextvars import ContextVar, copy_context
+from hashlib import sha256
+import json
+
+
+_construction = ContextVar("memory_agent_construction", default=None)
+
+
+class MemoryOwnerBusy(RuntimeError):
+    error_code = "memory_owner_rebuild_in_progress"
+    retryable = True
+
+    def __init__(self):
+        super().__init__(self.error_code)
+
+
+def record_constructing_agent(agent):
+    construction = _construction.get()
+    if construction is not None:
+        construction.created = agent
+        # Provider workers copy ContextVars. The construction token must not
+        # escape into their owner context or a later delegated construction.
+        _construction.set(None)
+    return construction
+
+
+def memory_configuration(config, skip_memory):
+    value = {"memory": (config or {}).get("memory"), "skip_memory": bool(skip_memory)}
+    return sha256(json.dumps(value, sort_keys=True, default=str).encode()).hexdigest()
+
+
+class MemoryManagerHandoff:
+    def __init__(self, old_agent, manager):
+        if getattr(old_agent, "_memory_manager", None) is not manager:
+            raise MemoryOwnerBusy()
+        self.old_agent, self.manager, self.adopted = old_agent, manager, None
+        old_agent._memory_manager = None
+
+    def adopt(self, agent):
+        if self.adopted is not None or self.old_agent._memory_manager is not None:
+            raise MemoryOwnerBusy()
+        self.adopted = agent
+        return self.manager
+
+    def withdraw(self):
+        if self.adopted is not None and getattr(self.adopted, "_memory_manager", None) is self.manager:
+            self.adopted._memory_manager = None
+
+
+class AgentConstruction:
+    def __init__(self, turn):
+        from hermes_constants import hermes_home_key
+        self.turn, self.runner, self.ctx = turn, turn._runner, turn._ctx
+        self.lock = getattr(self.runner, "_agent_cache_lock", None)
+        self.cache = getattr(self.runner, "_agent_cache", None)
+        self.key = (hermes_home_key(), self.ctx.session_id)
+        self.cache_key = self.ctx.session_key
+        self.original = self.reservation = self.created = self.handoff = None
+        self.old_agent = None
+        self.retired = False
+        self.current_context = copy_context()
+        self.owner_context = self.current_context
+        self.committed = False
+
+    def __enter__(self):
+        if self.lock is None or self.cache is None:
+            raise MemoryOwnerBusy()
+        with self.lock:
+            builds = self.runner.__dict__.setdefault("_memory_agent_builds", {})
+            if self.key in builds:
+                raise MemoryOwnerBusy()
+            builds[self.key] = self
+        self.token = _construction.set(self)
+        self.turn._memory_build = self
+        return self
+
+    def current(self):
+        check = getattr(self.ctx, "_run_still_current", None)
+        return callable(check) and check() is True
+
+    def reserve_locked(self, entry):
+        from gateway.run import _AGENT_PENDING_SENTINEL
+        if self.reservation is not None or self.cache.get(self.cache_key) is not entry:
+            raise MemoryOwnerBusy()
+        if entry is not None:
+            agent = entry[0]
+            if agent is _AGENT_PENDING_SENTINEL or id(agent) in self.runner._running_agent_ids():
+                raise MemoryOwnerBusy()
+            self.original, self.old_agent = entry, agent
+        self.reservation = (_AGENT_PENDING_SENTINEL, None, None, self.ctx.session_id, self)
+        self.cache[self.cache_key] = self.reservation
+
+    def assert_idle_locked(self, entry):
+        from gateway.run import _AGENT_PENDING_SENTINEL
+        if not self.current():
+            raise MemoryOwnerBusy()
+        if entry is not None and (entry[0] is _AGENT_PENDING_SENTINEL
+                                  or id(entry[0]) in self.runner._running_agent_ids()):
+            raise MemoryOwnerBusy()
+
+    def prepare(self, agent, platform, skip_memory):
+        from hermes_constants import get_hermes_home, hermes_home_key
+        from hermes_cli.profiles import get_active_profile_name
+        self.configuration = memory_configuration(self.ctx.user_config, skip_memory)
+        if agent is None:
+            return
+        if not self.current() or agent is not self.old_agent:
+            raise MemoryOwnerBusy()
+        manager = getattr(agent, "_memory_manager", None)
+        if manager is None:
+            return
+        stamp = getattr(agent, "_memory_owner_stamp", None)
+        if (stamp is None or stamp["home"] != self.key[0]
+                or getattr(manager, "_shutting_down", False)
+                or getattr(manager, "_teardown_claim", None) is not None):
+            raise MemoryOwnerBusy()
+        self.owner_context = stamp["context"]
+        context = dict(hermes_home=str(get_hermes_home()), agent_identity=get_active_profile_name(),
+                       agent_workspace="hermes", user_id=str(getattr(self.ctx.source, "user_id", "") or ""),
+                       platform=platform, agent_context=platform if platform in {"cron", "subagent"} else "primary")
+        reusable = (not skip_memory and stamp["configuration"] == self.configuration
+                    and stamp["session_id"] == self.ctx.session_id
+                    and stamp["user_id_alt"] == str(getattr(self.ctx.source, "user_id_alt", "") or "")
+                    and (getattr(manager, "_bound_scope", None) or {}).get("home_key") == hermes_home_key())
+        for provider in manager.providers:
+            check = getattr(provider, "can_reuse_for_session", None)
+            try:
+                allowed = callable(check) and check(self.ctx.session_id, **context) is True
+            except Exception:
+                allowed = False
+            reusable = reusable and allowed
+        if reusable and manager.providers:
+            self.handoff = MemoryManagerHandoff(agent, manager)
+        else:
+            # Drain the actual owner off the cache lock, under its captured
+            # native identity. A replacement cannot race an async teardown.
+            self.owner_context.copy().run(manager.release_soft)
+            agent._memory_manager = None
+            self.retired = True
+
+    def owner_changed(self, agent, platform, skip_memory):
+        """An opted-in provider may detect scope/source changes absent from model config."""
+        from hermes_constants import get_hermes_home
+        from hermes_cli.profiles import get_active_profile_name
+        manager = getattr(agent, "_memory_manager", None)
+        if manager is None:
+            return False
+        context = dict(hermes_home=str(get_hermes_home()), agent_identity=get_active_profile_name(),
+                       agent_workspace="hermes", user_id=str(getattr(self.ctx.source, "user_id", "") or ""),
+                       platform=platform, agent_context=platform if platform in {"cron", "subagent"} else "primary")
+        for provider in manager.providers:
+            check = getattr(provider, "can_reuse_for_session", None)
+            if not callable(check):
+                continue
+            try:
+                if skip_memory or check(self.ctx.session_id, **context) is not True:
+                    return True
+            except Exception:
+                return True
+        return False
+
+    @property
+    def manager_argument(self):
+        return self.handoff
+
+    def commit(self, agent, entry):
+        if not self.current():
+            raise MemoryOwnerBusy()
+        if self.handoff is not None and (self.handoff.adopted is not agent
+                or getattr(agent, "_memory_manager", None) is not self.handoff.manager):
+            raise MemoryOwnerBusy()
+        with self.lock:
+            if self.cache.get(self.cache_key) is not self.reservation:
+                raise MemoryOwnerBusy()
+            agent._memory_owner_stamp = {
+                "home": self.key[0], "session_id": self.ctx.session_id,
+                "user_id_alt": str(getattr(self.ctx.source, "user_id_alt", "") or ""),
+                "configuration": self.configuration, "context": self.current_context,
+            }
+            self.cache[self.cache_key] = entry
+            self.committed = True
+            self.runner._enforce_agent_cache_cap()
+
+    def _rollback(self):
+        if self.handoff is not None:
+            self.handoff.withdraw()
+        with self.lock:
+            ours = self.cache.get(self.cache_key) is self.reservation
+            restore = ours and self.original is not None and not self.retired and self.current()
+            if restore:
+                if self.handoff is not None:
+                    self.old_agent._memory_manager = self.handoff.manager
+                self.cache[self.cache_key] = self.original
+            elif ours:
+                self.cache.pop(self.cache_key, None)
+        manager = getattr(self.created, "_memory_manager", None) if self.created is not None else None
+        if self.handoff is not None and not restore:
+            manager = self.handoff.manager
+        if manager is not None:
+            cleanup_context = self.owner_context if self.handoff is not None else self.current_context
+            cleanup_context.copy().run(manager.release_soft)
+            if self.created is not None:
+                self.created._memory_manager = None
+        if self.old_agent is not None and not restore:
+            self.turn._release_evicted_agent(self.old_agent)
+
+    def __exit__(self, exc_type, exc, traceback):
+        try:
+            if self.reservation is not None and not self.committed:
+                self._rollback()
+        finally:
+            self.turn._memory_build = None
+            _construction.reset(self.token)
+            with self.lock:
+                builds = self.runner.__dict__.get("_memory_agent_builds", {})
+                if builds.get(self.key) is self:
+                    builds.pop(self.key)
